# Tourism dashboard configuration.
# Copy to .env and edit as needed:   cp .env.example .env
# Environment variables always override the defaults below. .env is git-ignored.

# Seconds between collection loops.
FETCH_INTERVAL_SECONDS=120
# HTTP timeout for every API request, in seconds.
REQUEST_TIMEOUT=10
# Number of retries per request (3 retries -> up to 4 attempts, backoff 2s/4s/8s).
RETRY_COUNT=3

# Paths (relative paths are resolved against the project folder).
DB_PATH=tourism.db
CSV_PATH=data/clean_tourism.csv
LOG_FILE=logs/app.log

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Upstream APIs (do not change unless an endpoint moves).
OPENSKY_URL=https://opensky-network.org/api/states/all
OPENMETEO_URL=https://api.open-meteo.com/v1/forecast
FRANKFURTER_URL=https://api.frankfurter.app/latest?from=USD&to=EUR,INR,JPY,GBP,SGD,AED

# Sent as the User-Agent on every request.
USER_AGENT=tourism-project/1.0

# Dashboard refresh cadence and live-data freshness thresholds, in seconds.
DASHBOARD_REFRESH_SECONDS=60
LIVE_MAX_AGE_SECONDS=300
STALE_MAX_AGE_SECONDS=1800

# Live data strategy: "db" reads only what fetcher.py stored (local/VPS);
# "ondemand" lets the dashboard collect a fresh round itself, which is what a
# shared host without a background collector needs (e.g. Streamlit Community Cloud).
LIVE_MODE=db
# Seconds an on-demand collection is reused before another one is allowed.
ON_DEMAND_TTL=120
